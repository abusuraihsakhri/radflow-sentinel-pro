# Radflow Sentinel Pro Environment Configuration
# Copy this file to .env and configure your values

# Required: HMAC-SHA256 audit trail signing key (use a strong random value)
AUDIT_SECRET_KEY=change-me-to-a-strong-random-secret-key

# Required for API access: independent high-entropy bearer token (do not commit .env)
API_TOKEN=replace-with-a-separate-long-random-token

# Only the deterministic mock provider is currently implemented
MODEL_PROVIDER=mock

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
