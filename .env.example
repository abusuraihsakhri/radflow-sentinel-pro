# Radflow Sentinel Pro Environment Configuration
# Copy this file to .env and configure your values

# Required: HMAC-SHA256 audit trail signing key (use a strong random value)
AUDIT_SECRET_KEY=change-me-to-a-strong-random-secret-key

# LLM Provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
